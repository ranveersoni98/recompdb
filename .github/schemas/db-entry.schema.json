{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recompiled port entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["game", "port", "compatibility"],
  "properties": {
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "original_platforms"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "original_platforms": {
          "type": "array",
          "description": "Original platforms, identified by stable lowercase hyphenated IDs.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "releases"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "releases": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/gameRelease"
                }
              }
            }
          }
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "repository_url",
        "project_url",
        "download_url",
        "target_platforms",
        "supported_game_releases",
        "ai_ported",
        "status",
        "requirements",
        "installation_notes",
        "license",
        "maintainers",
        "last_verified",
        "notes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "repository_url": {
          "type": "string",
          "format": "uri"
        },
        "project_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "download_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "target_platforms": {
          "type": "array",
          "description": "Operating systems supported by the recompiled port.",
          "items": {
            "type": "string",
            "enum": ["windows", "macos", "linux"]
          },
          "uniqueItems": true
        },
        "supported_game_releases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["release_id", "status", "notes"],
            "properties": {
              "release_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "status": {
                "type": "string",
                "enum": ["supported", "experimental"]
              },
              "notes": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "ai_ported": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["active", "development", "archived", "unknown"]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "installation_notes": {
          "type": ["string", "null"]
        },
        "license": {
          "type": ["string", "null"]
        },
        "maintainers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_verified": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "tested_environments", "notes"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["working", "partial", "unknown", "untested"]
        },
        "tested_environments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["os", "version", "architecture"],
            "properties": {
              "os": {
                "type": "string",
                "enum": ["windows", "macos", "linux", "android", "ios", "other"]
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "architecture": {
                "type": "string",
                "minLength": 1
              },
              "min_fps": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    }
  },
  "$defs": {
    "gameRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "region", "version", "identifiers", "storefronts", "notes"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "region": {
          "type": ["string", "null"]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "storefronts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "id"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
