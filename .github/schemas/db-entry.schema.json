{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recompiled port entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "game_name",
    "port_name",
    "description",
    "repository_url",
    "project_url",
    "download_url",
    "platforms",
    "supported_game_versions",
    "storefronts",
    "ai_ported",
    "status",
    "compatibility",
    "requirements",
    "installation_notes",
    "license",
    "maintainers",
    "last_verified",
    "notes"
  ],
  "properties": {
    "game_name": {
      "type": "string",
      "minLength": 1
    },
    "port_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "repository_url": {
      "type": "string",
      "format": "uri"
    },
    "project_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "download_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["windows", "macos", "linux"]
      },
      "uniqueItems": true
    },
    "supported_game_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "storefronts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "id"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ai_ported": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["active", "development", "archived", "unknown"]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "tested_environments", "notes"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["working", "partial", "unknown", "untested"]
        },
        "tested_environments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "version", "architecture"],
            "properties": {
              "platform": {
                "type": "string",
                "enum": ["windows", "macos", "linux", "android", "ios", "other"]
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "architecture": {
                "type": "string",
                "minLength": 1
              },
              "min_fps": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "installation_notes": {
      "type": ["string", "null"]
    },
    "license": {
      "type": ["string", "null"]
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_verified": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": ["string", "null"]
    }
  }
}
